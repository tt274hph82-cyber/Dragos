  {
   "beat": "1 cold open: the test",
   "text": "The man in the grey suit wants a test. A stopwatch. A glass room. Hold your breath. Pause."
  },
  {
   "beat": "1 cold open: escalating demos",
   "text": "Thirty seconds. The guards freeze. Sixty. You walk out the door. Ninety. Your vision goes grey."
  },
  {
   "beat": "2 the premise (title card)",
   "text": "What if you could pause time? Part two."
  },
  {
   "beat": "4 the turn: one real fact",
   "text": "Your brain burns a fifth of your body's oxygen. That's real."
  },
  {
   "beat": "5-7 cliffhanger",
   "text": "So you breathe. And he's right behind you. He never froze."
  }
 ],
