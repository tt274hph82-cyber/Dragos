 "science": [
  {
   "claim": "Most people can hold their breath for about a minute.",
   "working": "Clinical and science sources put an untrained healthy adult at about 30 to 90 seconds; 'about a minute' is the middle of that range, and Outside notes most people struggle to reach one minute without practice.",
   "source": "Acibadem (most healthy adults 30-90 s); BBC Science Focus (no longer than 90 s); Outside Online"
  },
  {
   "claim": "The world record, on pure oxygen, is twenty-nine minutes.",
   "working": "Vitomir Maričić, 29 min 03.07 s, Opatija, Croatia, 14 June 2025, Guinness 'Longest time breath held voluntarily underwater (male)', oxygen-assisted (pure oxygen breathed beforehand). It beat Budimir Šobat's 24:37 (2021). 29:03 rounds to 'twenty-nine minutes'.",
   "source": "Guinness World Records, longest-time-breath-held-voluntarily-male; Guinness news, Sept 2025"
  },
  {
   "claim": "The urge to breathe isn't your body running out of oxygen; it's carbon dioxide building up in the blood.",
   "working": "Breathing is driven mainly by blood CO2 sensed by the central chemoreceptors (about 80% of the response to high CO2); during a breath-hold rising CO2 triggers the urge before oxygen falls.",
   "source": "Central chemoreceptor (respiratory physiology); Pearson / Lecturio physiology notes"
  },
  {
   "claim": "Breathing fast and deep before holding your breath can make swimmers black out underwater without warning.",
   "working": "Hyperventilation lowers CO2 and delays the urge to breathe; oxygen can fall to the point of unconsciousness first. Called hypoxic blackout.",
   "source": "StatPearls, NCBI NBK554620; American Red Cross, YMCA of the USA and USA Swimming joint statement on hypoxic blackout (2022)"
  },
  {
   "claim": "Pause a hundred times a day and that's twenty-five extra days a year.",
   "working": "Each pause is about a minute: 100 min a day x 365 = 36,500 min = 25.3 days.",
   "source": "arithmetic"
  }
 ],
