 "script": [
  {
   "beat": "s",
   "text": "What if your mom started playing Block Quest?"
  },
  {
   "beat": "s",
   "text": "Which button is jump? Is it this one?",
   "who": "mom"
  },
  {
   "beat": "s",
   "text": "Level one. She walks straight into the lava. Twice."
  },
  {
   "beat": "s",
   "text": "Level fifty. She stops cooking dinner. You eat cereal. Again."
  },
  {
   "beat": "s",
   "text": "Level five hundred. She spends all your gems on a pink dragon."
  },
  {
   "beat": "s",
   "text": "Mom! Those were mine!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Shh. Mommy's in a boss fight.",
   "who": "mom"
  },
  {
   "beat": "s",
   "text": "Level nine hundred ninety-nine. She's number one in the whole world."
  },
  {
   "beat": "s",
   "text": "And now, you have to send her to bed."
  },
  {
   "beat": "s",
   "text": "Mom. Bedtime.",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Ten more seconds!",
   "who": "mom"
  },
  {
   "beat": "s",
   "text": "Comment mom if this is your house."
  }
 ],
