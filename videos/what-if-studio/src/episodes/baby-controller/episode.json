 "lead": 2,
 "script": [
  {
   "beat": "s",
   "text": "What if your baby brother grabbed your controller in Block Quest?"
  },
  {
   "beat": "s",
   "text": "Minute one. He drools on it. Somehow, that unlocks a secret level."
  },
  {
   "beat": "s",
   "text": "That level doesn't even exist!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Minute two. He chews the joystick. Your character does a triple backflip, and lands on the final boss."
  },
  {
   "beat": "s",
   "text": "Minute three. He falls asleep on the buttons. And sets a world record."
  },
  {
   "beat": "s",
   "text": "I've been trying that for two years!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Minute four. He wakes up, and throws the controller in the toilet."
  },
  {
   "beat": "s",
   "text": "Who wants to explain this?",
   "who": "mom"
  },
  {
   "beat": "s",
   "text": "And the baby just points at you."
  },
  {
   "beat": "s",
   "text": "Comment baby if yours is a menace."
  }
 ],
