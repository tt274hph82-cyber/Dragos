{
 "slug": "molasses",
 "title": "THE GREAT MOLASSES FLOOD",
 "fps": 30,
 "total": 3622,
 "segments": [
  {
   "shot": "S1",
   "a": 0,
   "b": 72,
   "t0": 0,
   "t1": 72,
   "line": "Boston, 1919."
  },
  {
   "shot": "S2",
   "a": 72,
   "b": 101,
   "t0": 0,
   "t1": 29,
   "line": "Lunchtime."
  },
  {
   "shot": "S3",
   "a": 101,
   "b": 201,
   "t0": 0,
   "t1": 100,
   "line": "A sound like a machine gun rips through the harbour."
  },
  {
   "shot": "S4",
   "a": 201,
   "b": 309,
   "t0": 0,
   "t1": 108,
   "line": "Then a wave as tall as a house comes down the street."
  },
  {
   "shot": "S5",
   "a": 309,
   "b": 378,
   "t0": 0,
   "t1": 69,
   "line": "But it isn't water. It's syrup."
  },
  {
   "shot": "S6",
   "a": 378,
   "b": 452,
   "t0": 0,
   "t1": 74,
   "line": "This is the Great Molasses Flood."
  },
  {
   "shot": "S7",
   "a": 452,
   "b": 519,
   "t0": 0,
   "t1": 67,
   "line": "And yes, it really happened."
  },
  {
   "shot": "S8",
   "a": 519,
   "b": 657,
   "t0": 0,
   "t1": 138,
   "line": "On the waterfront stood a giant steel tank, fifteen metres tall."
  },
  {
   "shot": "S9",
   "a": 657,
   "b": 788,
   "t0": 0,
   "t1": 131,
   "line": "Inside: about eight point seven million litres of molasses,"
  },
  {
   "shot": "S10",
   "a": 788,
   "b": 852,
   "t0": 0,
   "t1": 64,
   "line": "waiting to be turned into alcohol."
  },
  {
   "shot": "S11",
   "a": 852,
   "b": 894,
   "t0": 0,
   "t1": 42,
   "line": "But the tank leaked."
  },
  {
   "shot": "S12",
   "a": 894,
   "b": 1040,
   "t0": 0,
   "t1": 146,
   "line": "So badly that the company painted it brown, so nobody could see the leaks."
  },
  {
   "shot": "S13",
   "a": 1040,
   "b": 1148,
   "t0": 0,
   "t1": 108,
   "line": "Neighbours came with cups and buckets to take the drips home."
  },
  {
   "shot": "S14",
   "a": 1148,
   "b": 1218,
   "t0": 0,
   "t1": 70,
   "line": "Then, January fifteenth."
  },
  {
   "shot": "S15",
   "a": 1218,
   "b": 1351,
   "t0": 0,
   "t1": 133,
   "line": "After days of freezing cold, the air suddenly turned warm."
  },
  {
   "shot": "S16",
   "a": 1351,
   "b": 1409,
   "t0": 0,
   "t1": 58,
   "line": "Just after half past twelve, the"
  },
  {
   "shot": "S17",
   "a": 1409,
   "b": 1493,
   "t0": 0,
   "t1": 84,
   "line": "rivets started popping, like gunshots."
  },
  {
   "shot": "S18",
   "a": 1493,
   "b": 1548,
   "t0": 0,
   "t1": 55,
   "line": "And the tank burst open."
  },
  {
   "shot": "S19",
   "a": 1548,
   "b": 1655,
   "t0": 0,
   "t1": 107,
   "line": "A brown wave, up to seven and a half metres high,"
  },
  {
   "shot": "S20",
   "a": 1655,
   "b": 1761,
   "t0": 0,
   "t1": 106,
   "line": "rushed through the streets at about fifty- five kilometres an hour."
  },
  {
   "shot": "S21",
   "a": 1761,
   "b": 1837,
   "t0": 0,
   "t1": 76,
   "line": "It knocked houses off their foundations."
  },
  {
   "shot": "S22",
   "a": 1837,
   "b": 1923,
   "t0": 0,
   "t1": 86,
   "line": "It bent the steel of the elevated railway."
  },
  {
   "shot": "S23",
   "a": 1923,
   "b": 1999,
   "t0": 0,
   "t1": 76,
   "line": "Wagons, horses, people."
  },
  {
   "shot": "S24",
   "a": 1999,
   "b": 2046,
   "t0": 0,
   "t1": 47,
   "line": "It took everything."
  },
  {
   "shot": "S25",
   "a": 2046,
   "b": 2098,
   "t0": 0,
   "t1": 52,
   "line": "And here comes the worst part."
  },
  {
   "shot": "S26",
   "a": 2098,
   "b": 2227,
   "t0": 0,
   "t1": 129,
   "line": "In the cold winter air, the molasses got thick, like glue."
  },
  {
   "shot": "S27",
   "a": 2227,
   "b": 2358,
   "t0": 0,
   "t1": 131,
   "line": "People could not swim out. The harder they fought, the deeper they sank."
  },
  {
   "shot": "S28",
   "a": 2358,
   "b": 2493,
   "t0": 0,
   "t1": 135,
   "line": "Sailors, firemen and doctors waded in to pull people out."
  },
  {
   "shot": "S29",
   "a": 2493,
   "b": 2598,
   "t0": 0,
   "t1": 105,
   "line": "Twenty- one people died. About a hundred and fifty were hurt."
  },
  {
   "shot": "S30",
   "a": 2598,
   "b": 2657,
   "t0": 0,
   "t1": 59,
   "line": "The clean- up took weeks."
  },
  {
   "shot": "S31",
   "a": 2657,
   "b": 2723,
   "t0": 0,
   "t1": 66,
   "line": "Fireboats sprayed sea water to wash"
  },
  {
   "shot": "S32",
   "a": 2723,
   "b": 2750,
   "t0": 0,
   "t1": 27,
   "line": "the streets,"
  },
  {
   "shot": "S33",
   "a": 2750,
   "b": 3036,
   "t0": 0,
   "t1": 286,
   "line": "and the harbour stayed brown until summer. The company blamed anarchists. The court said no: the tank was too thin, and had never been properly tested."
  },
  {
   "shot": "S34",
   "a": 3036,
   "b": 3147,
   "t0": 0,
   "t1": 111,
   "line": "After that, engineers had to sign off on their designs."
  },
  {
   "shot": "S35",
   "a": 3147,
   "b": 3221,
   "t0": 0,
   "t1": 74,
   "line": "Rules that still protect us today."
  },
  {
   "shot": "S36",
   "a": 3221,
   "b": 3348,
   "t0": 0,
   "t1": 127,
   "line": "So yes, twenty- one people drowned in syrup. That's real."
  },
  {
   "shot": "S37",
   "a": 3348,
   "b": 3488,
   "t0": 0,
   "t1": 140,
   "line": "Next time someone says slow as molasses, tell them about Boston."
  },
  {
   "shot": "S38",
   "a": 3488,
   "b": 3622,
   "t0": 0,
   "t1": 134,
   "line": "Follow for more strange history."
  }
 ],
