 "lead": 2,
 "script": [
  {
   "beat": "s",
   "text": "What if you never stopped playing Block Quest?"
  },
  {
   "beat": "s",
   "text": "Hour one. Just one more round."
  },
  {
   "beat": "s",
   "text": "Dinner's ready!",
   "who": "mom"
  },
  {
   "beat": "s",
   "text": "Five more minutes!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Day ten. You haven't showered. Your room smells like a swamp."
  },
  {
   "beat": "s",
   "text": "Month six. Your chair melts into your shape. Spiders build a city on your head."
  },
  {
   "beat": "s",
   "text": "Honey? Are you even alive in there?",
   "who": "mom"
  },
  {
   "beat": "s",
   "text": "Shh! I'm almost max level!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Year forty. Your beard touches the floor. The game runs out of levels."
  },
  {
   "beat": "s",
   "text": "Year eighty. You finally beat the last boss."
  },
  {
   "beat": "s",
   "text": "I did it! I won!",
   "who": "old"
  },
  {
   "beat": "s",
   "text": "But then, your grandkid walks in."
  },
  {
   "beat": "s",
   "text": "Grandpa, can I play?",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Sure, kiddo. Just one more round.",
   "who": "old"
  },
  {
   "beat": "s",
   "text": "Comment one more if this is you."
  }
 ],
