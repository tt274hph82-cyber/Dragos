 "lead": 2,
 "script": [
  {
   "beat": "s",
   "text": "What if your teacher joined Block Quest?"
  },
  {
   "beat": "s",
   "text": "Period one. He gives the final boss homework."
  },
  {
   "beat": "s",
   "text": "Boss! Where is your essay?",
   "who": "teach"
  },
  {
   "beat": "s",
   "text": "The boss cries and runs away."
  },
  {
   "beat": "s",
   "text": "Period two. He puts the whole server in detention. Three hundred players. One tiny classroom."
  },
  {
   "beat": "s",
   "text": "Sir, it's summer break!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Not in this game.",
   "who": "teach"
  },
  {
   "beat": "s",
   "text": "Period three. Pop quiz. Get it wrong, and you fall in the lava."
  },
  {
   "beat": "s",
   "text": "What is seven times eight?",
   "who": "teach"
  },
  {
   "beat": "s",
   "text": "Uh... fifty-four?",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Splash."
  },
  {
   "beat": "s",
   "text": "Period four. He gives every player an F. Even the dragon."
  },
  {
   "beat": "s",
   "text": "But then, he sees your score. You're number one in the whole game."
  },
  {
   "beat": "s",
   "text": "Hmm. A plus. Extra credit.",
   "who": "teach"
  },
  {
   "beat": "s",
   "text": "Comment teacher if yours would do this."
  }
 ],
