 "lead": 2,
 "script": [
  {
   "beat": "s",
   "text": "What if your best friend quit Block Quest?"
  },
  {
   "beat": "s",
   "text": "I'm done, bro. Bye.",
   "who": "max"
  },
  {
   "beat": "s",
   "text": "His avatar just freezes. Then, poof. Gone."
  },
  {
   "beat": "s",
   "text": "Day one. You play alone. The whole lobby feels empty."
  },
  {
   "beat": "s",
   "text": "Day two. You find his old base. His pet dragon is still waiting by the door."
  },
  {
   "beat": "s",
   "text": "Day three. You finally beat the boss you two never could. Nobody to high-five."
  },
  {
   "beat": "s",
   "text": "Then, a message pops up."
  },
  {
   "beat": "s",
   "text": "Bro. My mom took my computer. I'm back!",
   "who": "max"
  },
  {
   "beat": "s",
   "text": "Best friends don't quit. They just get grounded."
  },
  {
   "beat": "s",
   "text": "Tag the friend who would never quit on you."
  }
 ],
