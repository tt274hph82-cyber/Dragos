 "lead": 2,
 "script": [
  {
   "beat": "s",
   "text": "What if you hacked Block Quest?"
  },
  {
   "beat": "s",
   "text": "Hack one. Fly mode."
  },
  {
   "beat": "s",
   "text": "I can fly! I can actually fly!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Hack two. Infinite gems. The counter can't even count that high."
  },
  {
   "beat": "s",
   "text": "Hack three. Giant mode. You step on the whole lobby."
  },
  {
   "beat": "s",
   "text": "Hack four. You delete the final boss."
  },
  {
   "beat": "s",
   "text": "Warning. Cheater detected.",
   "who": "sys"
  },
  {
   "beat": "s",
   "text": "And now, the game hacks you back."
  },
  {
   "beat": "s",
   "text": "Your gems turn into socks. Your sword turns into a noodle. Your hoodie turns pink."
  },
  {
   "beat": "s",
   "text": "Okay, okay! I'm sorry! Undo! Undo!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Error. Undo not found.",
   "who": "sys"
  },
  {
   "beat": "s",
   "text": "And that's how you became a chicken. Forever."
  },
  {
   "beat": "s",
   "text": "Bawk?",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Comment hack if you'd still press the button."
  }
 ],
