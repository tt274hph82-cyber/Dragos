 "lead": 2,
 "script": [
  {
   "beat": "s",
   "text": "What if you got one gem every time you blinked?"
  },
  {
   "beat": "s",
   "text": "Blink. One gem."
  },
  {
   "beat": "s",
   "text": "Blink, blink, blink. Ten gems."
  },
  {
   "beat": "s",
   "text": "You blink so fast, the counter breaks."
  },
  {
   "beat": "s",
   "text": "You buy a golden mansion, a rocket, and a robot butler."
  },
  {
   "beat": "s",
   "text": "I can't stop blinking!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Gems are raining from the sky. The whole server is flooding."
  },
  {
   "beat": "s",
   "text": "Then, the admin shows up."
  },
  {
   "beat": "s",
   "text": "Who broke my economy?",
   "who": "admin"
  },
  {
   "beat": "s",
   "text": "You try not to blink. Your eyes are burning. Then, you sneeze."
  },
  {
   "beat": "s",
   "text": "Infinity gems."
  },
  {
   "beat": "s",
   "text": "Comment blink if you blinked while watching this."
  }
 ],
