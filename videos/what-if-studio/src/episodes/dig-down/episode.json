 "lead": 2,
 "script": [
  {
   "beat": "s",
   "text": "What if you dug straight down in Block Quest, and never stopped?"
  },
  {
   "beat": "s",
   "text": "Layer one. Dirt. Easy."
  },
  {
   "beat": "s",
   "text": "This is gonna be so quick!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Layer two. Stone. Your pickaxe breaks. You dig with a spoon."
  },
  {
   "beat": "s",
   "text": "Layer three. Gems! Everywhere! But you can't stop to grab them."
  },
  {
   "beat": "s",
   "text": "No, no, no! My gems!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Layer four. Lava. You surf across it on a door."
  },
  {
   "beat": "s",
   "text": "Layer five. Bedrock. Nobody has ever broken it. You break it. With the spoon."
  },
  {
   "beat": "s",
   "text": "And then, you fall out the bottom of the world."
  },
  {
   "beat": "s",
   "text": "Aaaah!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Straight into the sky. And you land, right back in your own house."
  },
  {
   "beat": "s",
   "text": "Who put a hole in my roof?!",
   "who": "mom"
  },
  {
   "beat": "s",
   "text": "Comment dig if you'd keep going."
  }
 ],
