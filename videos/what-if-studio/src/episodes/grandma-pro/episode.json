 "lead": 2,
 "script": [
  {
   "beat": "s",
   "text": "What if your grandma was secretly a pro gamer?"
  },
  {
   "beat": "s",
   "text": "Round one. You teach her Block Quest. She's holding the controller upside down."
  },
  {
   "beat": "s",
   "text": "Grandma, that's the wrong way.",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Oh, is it, sweetie?",
   "who": "gran"
  },
  {
   "beat": "s",
   "text": "Then she wins. In four seconds."
  },
  {
   "beat": "s",
   "text": "Round two. She builds a castle faster than you can blink. With a cookie shop inside."
  },
  {
   "beat": "s",
   "text": "Round three. She beats the final boss. While knitting."
  },
  {
   "beat": "s",
   "text": "Back in my day, bosses had three health bars.",
   "who": "gran"
  },
  {
   "beat": "s",
   "text": "Round four. The number one player in the world challenges her."
  },
  {
   "beat": "s",
   "text": "Grandma, nobody beats him!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "He loses in one hit. Then he asks for her cookie recipe."
  },
  {
   "beat": "s",
   "text": "Turns out, Grandma was the world champion. In nineteen eighty-two."
  },
  {
   "beat": "s",
   "text": "Now, who wants cookies?",
   "who": "gran"
  },
  {
   "beat": "s",
   "text": "Comment grandma if yours could beat you."
  }
 ],
