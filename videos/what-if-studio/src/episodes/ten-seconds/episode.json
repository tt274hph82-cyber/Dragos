 "script": [
  {
   "beat": "s",
   "text": "What if your mom only gave you ten seconds of games?"
  },
  {
   "beat": "s",
   "text": "Ten seconds. Then bed.",
   "who": "mom"
  },
  {
   "beat": "s",
   "text": "Ten seconds? That's nothing. Unless you're a speedrunner."
  },
  {
   "beat": "s",
   "text": "Second ten. You beat a hundred-level parkour, in one jump."
  },
  {
   "beat": "s",
   "text": "Second nine. The Block Boss spawns. One punch. K.O."
  },
  {
   "beat": "s",
   "text": "Second eight. He drops a billion gems."
  },
  {
   "beat": "s",
   "text": "Second seven. You buy the whole shop. Even the toaster skin."
  },
  {
   "beat": "s",
   "text": "Three. Two.",
   "who": "mom"
  },
  {
   "beat": "s",
   "text": "Then you find this. Plus ten seconds."
  },
  {
   "beat": "s",
   "text": "Not again!",
   "who": "mom"
  },
  {
   "beat": "s",
   "text": "Comment loop if you watched this twice."
  }
 ],
