 "lead": 2,
 "script": [
  {
   "beat": "s",
   "text": "What if your dad became the final boss of Block Quest?"
  },
  {
   "beat": "s",
   "text": "Phase one. He blocks every jump with the TV remote."
  },
  {
   "beat": "s",
   "text": "Not until you finish your homework!",
   "who": "dad"
  },
  {
   "beat": "s",
   "text": "Phase two. He turns all the lava into broccoli."
  },
  {
   "beat": "s",
   "text": "Dad! That's even worse!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Phase three. He summons the chore list. Two hundred chores."
  },
  {
   "beat": "s",
   "text": "Take out the trash. Then we talk.",
   "who": "dad"
  },
  {
   "beat": "s",
   "text": "Final phase. He unplugs the Wi-Fi."
  },
  {
   "beat": "s",
   "text": "Noooo!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "But every boss has a weak spot. And dad's is a bad joke."
  },
  {
   "beat": "s",
   "text": "Dad, why did the block cross the road? To get to the other slide!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Ha! Ha! Okay, okay. Ten more minutes.",
   "who": "dad"
  },
  {
   "beat": "s",
   "text": "Boss defeated. Comment dad if this is your house."
  }
 ],
