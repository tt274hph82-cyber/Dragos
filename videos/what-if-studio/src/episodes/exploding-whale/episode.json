{
 "id": "ExplodingWhale",
 "slug": "exploding-whale",
 "topic": "The Exploding Whale, Florence, Oregon, 1970: a story Short in the Dancing Plague v2 look, frames locked to the narration, a sound on every camera move",
 "title": [
  "THE EXPLODING",
  "WHALE"
 ],
 "accent": "WHALE",
 "lead": 0.4,
 "tail": 2.0,
 "voice": {
  "id": "QvlD90AkjGTCqc9685Rq",
