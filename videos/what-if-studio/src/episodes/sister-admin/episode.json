 "lead": 2,
 "script": [
  {
   "beat": "s",
   "text": "What if your little sister got admin powers in Block Quest?"
  },
  {
   "beat": "s",
   "text": "Command one. She turns the whole world pink."
  },
  {
   "beat": "s",
   "text": "Not the lava! The lava was cool!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Command two. She freezes you in mid-air. For ten minutes."
  },
  {
   "beat": "s",
   "text": "Say my sister is the best, and I'll unfreeze you.",
   "who": "sis"
  },
  {
   "beat": "s",
   "text": "My sister... is the best.",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Command three. The final boss has to join her tea party."
  },
  {
   "beat": "s",
   "text": "Command four. She bans you. From your own game."
  },
  {
   "beat": "s",
   "text": "Okay! All my candy, for the admin powers!",
   "who": "kid"
  },
  {
   "beat": "s",
   "text": "Deal!",
   "who": "sis"
  },
  {
   "beat": "s",
   "text": "Finally, you're the admin. You type your first command."
  },
  {
   "beat": "s",
   "text": "But then, a message pops up. Owner is online."
  },
  {
   "beat": "s",
   "text": "Slash bedtime. Everyone.",
   "who": "mom"
  },
  {
   "beat": "s",
   "text": "Comment sister if yours would do this."
  }
 ],
