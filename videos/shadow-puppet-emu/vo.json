[
 {
  "start": 0.2,
  "dur": 2.664,
  "file": "vo/01t.mp3",
  "text": "Western Australia, 1932."
 },
 {
  "start": 2.9,
  "dur": 3.422,
  "file": "vo/02t.mp3",
  "text": "Twenty thousand emus were eating the farmers' wheat."
 },
 {
  "start": 7.7,
  "dur": 3.944,
  "file": "vo/03t.mp3",
  "text": "So the army sent two machine guns, and ten thousand bullets."
 },
 {
  "start": 11.7,
  "dur": 2.038,
  "file": "vo/04t.mp3",
  "text": "But the emus split up and ran."
 },
 {
  "start": 14.3,
  "dur": 3.056,
  "file": "vo/05t.mp3",
  "text": "Fifty kilometres an hour. No truck could keep up."
 },
 {
  "start": 17.55,
  "dur": 1.358,
  "file": "vo/06t.mp3",
  "text": "Then a gun jammed."
 },
 {
  "start": 19.85,
  "dur": 4.78,
  "file": "vo/07t.mp3",
  "text": "Nearly ten thousand bullets. Nine hundred and eighty-six emus."
 },
 {
  "start": 24.8,
  "dur": 1.437,
  "file": "vo/08t.mp3",
  "text": "Ten bullets per bird."
 },
 {
  "start": 27.4,
  "dur": 1.149,
  "file": "vo/09t.mp3",
  "text": "The army went home."
 },
 {
  "start": 29.6,
  "dur": 1.123,
  "file": "vo/10t.mp3",
  "text": "The emus won."
 }
]