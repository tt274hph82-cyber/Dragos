 "lines": [
  {
   "id": "hook",
   "text": "Ever notice your phone races to eighty percent, then crawls?",
   "start": 0.5,
   "end": 4.33
  },
  {
   "id": "inside",
   "text": "Inside the battery, charging pushes lithium ions from one side to the other.",
   "start": 4.63,
   "end": 9.463
  },
  {
   "id": "room",
   "text": "At first, there's plenty of empty room.",
   "start": 9.713,
   "end": 12.153
  },
  {
   "id": "full",
   "text": "But near full, the last free spots are hard to find.",
   "start": 12.403,
   "end": 15.79
  },
  {
   "id": "push",
   "text": "Push too hard, and the ions pile up and damage the cell.",
   "start": 16.09,
   "end": 19.814
  },
  {
   "id": "slow",
   "text": "So your phone slows down on purpose.",
   "start": 20.164,
   "end": 22.81
  }
 ],
