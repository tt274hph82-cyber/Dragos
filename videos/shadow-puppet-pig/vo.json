[
 {
  "start": 0.2,
  "dur": 2.795,
  "file": "vo/01t.mp3",
  "text": "San Juan Island, 1859."
 },
 {
  "start": 3.29,
  "dur": 5.825,
  "file": "vo/02t.mp3",
  "text": "Britain and America both claimed it. Then a British pig ate an American's potatoes."
 },
 {
  "start": 9.42,
  "dur": 1.489,
  "file": "vo/03t.mp3",
  "text": "So he shot the pig."
 },
 {
  "start": 11.42,
  "dur": 1.802,
  "file": "vo/04t.mp3",
  "text": "The British threatened to arrest him."
 },
 {
  "start": 14.12,
  "dur": 2.508,
  "file": "vo/05t.mp3",
  "text": "America sent in sixty-four soldiers."
 },
 {
  "start": 17.02,
  "dur": 1.907,
  "file": "vo/06t.mp3",
  "text": "Britain sent three warships."
 },
 {
  "start": 19.92,
  "dur": 4.284,
  "file": "vo/07t.mp3",
  "text": "Soon, hundreds of soldiers faced two thousand British sailors."
 },
 {
  "start": 24.5,
  "dur": 4.389,
  "file": "vo/08t.mp3",
  "text": "But the British admiral refused to start a war. Not over a pig."
 },
 {
  "start": 29.19,
  "dur": 2.952,
  "file": "vo/09t.mp3",
  "text": "Both armies shared the island for twelve years."
 },
 {
  "start": 32.44,
  "dur": 3.527,
  "file": "vo/10t.mp3",
  "text": "Then the German Kaiser decided: America gets it."
 },
 {
  "start": 36.27,
  "dur": 1.881,
  "file": "vo/11t.mp3",
  "text": "Casualties? One pig."
 }
]