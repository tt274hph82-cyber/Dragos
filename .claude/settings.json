{
  "statusLine": {
    "type": "command",
    "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/statusline.py\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/trim_noisy_bash.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HYPERFRAMES_TELEMETRY=0 npx --yes hyperframes@0.9.20 skills update >/dev/null 2>&1 || true",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
